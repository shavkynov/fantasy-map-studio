{
  "name": "fantasy-map-studio",
  "version": "0.89.0",
  "private": true,
  "description": "Генератор фэнтези-карт с тектоникой и рисованным стилем",
  "main": "main.js",
  "scripts": {
    "start": "node scripts/ensure-electron.js && electron .",
    "setup": "node scripts/ensure-electron.js",
    "check": "node scripts/check.js",
    "release": "node scripts/release.js",
    "dist:dmg": "electron-builder --mac dmg --arm64 --publish never",
    "dist:dmg-intel": "electron-builder --mac dmg --x64 --publish never",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux AppImage --x64 --publish never",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  },
  "author": {
    "name": "Александр Шавкунов"
  },
  "license": "UNLICENSED",
  "build": {
    "appId": "com.shavkunov.fantasymapstudio",
    "productName": "Fantasy Map Studio",
    "copyright": "© Александр Шавкунов",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "build/icon.png",
      "build/icon.ico"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.graphics-design",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Fantasy Map Studio ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Fantasy Map Studio",
      "artifactName": "FantasyMapStudio-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "artifactName": "FantasyMapStudio-${version}-linux-x64.${ext}"
    },
    "artifactName": "FantasyMapStudio-${version}.${ext}"
  }
}
